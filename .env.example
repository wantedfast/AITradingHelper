OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESEARCH_MODEL=gpt-4.1
RESEARCH_DEPTH=light
WORKBENCH_AGENT_MODEL=gpt-4.1
WORKBENCH_WEB_SEARCH=1
WORKBENCH_MAX_INPUT_TOKENS=5000
WORKBENCH_MAX_OUTPUT_TOKENS=1800
ENABLE_FULL_MEMO=0

# Auth and admin
ADMIN_PHONE=replace-with-admin-login
ADMIN_PASSWORD=replace-with-a-strong-password
SMS_PROVIDER=log
EMAIL_PROVIDER=smtp
# Gmail SMTP example (requires Google 2-Step Verification and a 16-character
# app password; never commit the real address or app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-sender@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=your-sender@gmail.com
# SMTP_FROM_NAME=盈航
# SMTP_USE_SSL=1
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-account@example.com
SMTP_PASSWORD=your-smtp-password-or-auth-code
SMTP_FROM=your-smtp-account@example.com
SMTP_FROM_NAME=盈航
SMTP_USE_SSL=1
# Gmail IMAP bounce worker (optional). When enabled, the backend polls the
# sender inbox for unread MAILER-DAEMON / postmaster DSNs and only suppresses
# explicit block / blacklist rejections. Processed block DSNs are archived and
# marked seen; all other inbox messages remain untouched.
BOUNCE_IMAP_ENABLED=0
# BOUNCE_IMAP_HOST=imap.gmail.com
# BOUNCE_IMAP_PORT=993
# BOUNCE_IMAP_USER=your-sender@gmail.com
# BOUNCE_IMAP_PASSWORD=your-16-character-app-password

# Microsoft Graph（个人 Outlook/Hotmail 使用 delegated OAuth，一次授权后自动刷新）
# EMAIL_PROVIDER 可在邮件管理后台连接成功后切换为 outlook_graph。
OUTLOOK_GRAPH_CLIENT_ID=
OUTLOOK_GRAPH_CLIENT_SECRET=
OUTLOOK_GRAPH_TENANT=consumers
# 可选：有 HTTPS 域名时配置授权码回调；留空则后台使用微软设备代码授权（适合仅 HTTP/IP 部署）。
OUTLOOK_GRAPH_REDIRECT_URI=
OUTLOOK_GRAPH_FROM=your-account@outlook.com
# 使用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成，严禁提交真实值。
OUTLOOK_GRAPH_TOKEN_ENCRYPTION_KEY=
PUBLIC_SITE_URL=http://123.56.166.126
ADMIN_PAYMENT_NOTIFY_EMAIL=admin@example.com

# Alipay face-to-face QR code payment
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.example.com/api/pay/alipay/notify
ALIPAY_SANDBOX=0
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_TIMEOUT_EXPRESS=15m

# Manual membership payment
PAYMENT_MONTHLY_AMOUNT_CENTS=5900
PAYMENT_MONTHLY_PLAN_NAME=月度会员
PAYMENT_MONTHLY_DURATION_DAYS=31
PAYMENT_ANNUAL_AMOUNT_CENTS=39900
PAYMENT_ANNUAL_PLAN_NAME=年度会员
PAYMENT_ANNUAL_DURATION_DAYS=365
PAYMENT_ALIPAY_QR_URL=/pay/alipay-qr.jpg
PAYMENT_WECHAT_QR_URL=/pay/wechat-qr.jpg

# Jinshuju payment form checkout.
# Create a Jinshuju paid form with fields matching these field codes.
# Default field mapping: field_1=order_no, field_2=user email, field_3=package id, field_4=user id.
JINSHUJU_FORM_URL=
JINSHUJU_WEBHOOK_SECRET=
JINSHUJU_FORM_TOKEN=
JINSHUJU_ORDER_FIELD=field_1
JINSHUJU_EMAIL_FIELD=field_2
JINSHUJU_PACKAGE_FIELD=field_3
JINSHUJU_USER_FIELD=field_4
# Secret used by Codex to push completed AI market-day reports.
MARKET_DAY_WEBHOOK_SECRET=
# Optional fields if your form wants to display them.
# JINSHUJU_PLAN_FIELD=field_5
# JINSHUJU_AMOUNT_FIELD=field_6
# Optional package-specific form URLs:
# JINSHUJU_FORM_URL_PACK_10=
# JINSHUJU_FORM_URL_PACK_50=
# JINSHUJU_FORM_URL_PACK_120=

# Trade file OCR / parsing. Defaults to DeepSeek-compatible chat completions.
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional override for AI watch-plan JSON generation.
WATCH_DEEPSEEK_MODEL=deepseek-chat

# Stock reverse research. User-facing jobs are pinned to Luna by default;
# missing credentials fail before enqueueing and never silently fall back.
STOCK_RESEARCH_ACCESS=admin
STOCK_RESEARCH_PROVIDER=luna
# Successful v2 reports are kept as a persistent shared cache. Each user pays
# once for access to a report version; reopening their history is free.
STOCK_RESEARCH_REQUIRE_LUNA_FOR_USERS=1
STOCK_RESEARCH_ALLOW_AUTOMATIC_PROVIDER_SELECTION=0
OPENAI_API_KEY=
# Optional dedicated HTTP proxy used only by Luna/OpenAI requests.
# OPENAI_PROXY_URL=http://host.docker.internal:7890
# STOCK_RESEARCH_LUNA_MODEL=gpt-5.6-luna
# Benchmark-only alternative provider credentials:
# ARK_API_KEY=
# STOCK_RESEARCH_DEEPSEEK_FLASH_MODEL=deepseek-chat
# STOCK_RESEARCH_DEEPSEEK_PRO_MODEL=deepseek-reasoner
# Optional overrides for trade OCR only:
# TRADE_OCR_API_KEY=
# TRADE_OCR_BASE_URL=
# TRADE_OCR_MODEL=
