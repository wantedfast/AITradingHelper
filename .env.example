OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESEARCH_MODEL=gpt-4.1
RESEARCH_DEPTH=light
WORKBENCH_AGENT_MODEL=gpt-4.1
WORKBENCH_WEB_SEARCH=1
WORKBENCH_MAX_INPUT_TOKENS=5000
WORKBENCH_MAX_OUTPUT_TOKENS=1800
ENABLE_FULL_MEMO=0

# Auth and admin
ADMIN_PHONE=replace-with-admin-login
ADMIN_PASSWORD=replace-with-a-strong-password
SMS_PROVIDER=log
EMAIL_PROVIDER=log
