{
  "name": "trade-review-agent-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['.next','.next-dev']) fs.rmSync(dir,{recursive:true,force:true})\"",
    "dev": "node -e \"const cp=require('child_process'); process.env.NEXT_DIST_DIR='.next-dev'; const next=require.resolve('next/dist/bin/next'); const child=cp.spawn(process.execPath,[next,'dev','--hostname','0.0.0.0','--port','3000'],{stdio:'inherit',env:process.env}); child.on('exit', code => process.exit(code ?? 0));\"",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:clean": "npm run clean && npm run build && next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "test:responsive": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "clsx": "^2.1.1",
    "echarts": "^5.5.1",
    "lucide-react": "^0.468.0",
    "next": "^14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.25.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.3.0",
    "three": "^0.165.0",
    "typescript": "^5.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.4",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  }
}
